# EraEdu local backend configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Supabase Project Settings → API
SUPABASE_URL=https://vfbsolxteyyactnzocdd.supabase.co
SUPABASE_KEY=replace-with-your-supabase-anon-key
# Keep this server-only. Never put it in frontend environment variables.
SUPABASE_SERVICE_KEY=replace-with-your-supabase-service-role-key

# Generate a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-32-character-minimum-secret

# Optional integrations
GEMINI_API_KEY=
RESEND_API_KEY=
LOG_LEVEL=debug
